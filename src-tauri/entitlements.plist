<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ALAN Echo records audio to transcribe it. Under the hardened runtime
       (auto-enabled by Tauri when signing), microphone capture requires this
       entitlement; without it CoreAudio access is silently denied. The
       NSMicrophoneUsageDescription prompt string lives in Info.plist. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
